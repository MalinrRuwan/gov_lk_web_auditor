{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nuuuwan/glwa/audit-1.0.0.json",
  "title": "glwa Level 0 audit",
  "type": "object",
  "required": [
    "schema_version",
    "audit_id",
    "url",
    "normalized_url",
    "started_at",
    "completed_at",
    "result",
    "evidence",
    "observations",
    "snapshots",
    "reviewer_decisions"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "audit_id": { "type": "string", "format": "uuid" },
    "url": { "type": "string" },
    "normalized_url": { "type": "string", "format": "uri" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "result": { "$ref": "#/$defs/result" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "observations": { "type": "array", "items": { "type": "object" } },
    "snapshots": { "type": "array", "items": { "$ref": "#/$defs/snapshot" } },
    "reviewer_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewerDecision" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "result": {
      "type": "object",
      "required": ["status", "confidence", "reasons"],
      "properties": {
        "status": {
          "enum": ["level_0_confirmed", "likely_level_0", "inconclusive"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["check", "status", "detail"],
      "properties": {
        "check": { "type": "string" },
        "status": { "enum": ["pass", "fail", "error", "review"] },
        "detail": { "type": "string" },
        "source": { "type": "string" },
        "observed_at": { "type": "string", "format": "date-time" },
        "data": { "type": "object" }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": ["url", "path", "sha256", "bytes"],
      "properties": {
        "url": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "reviewerDecision": {
      "type": "object",
      "required": ["reviewer", "decision", "decided_at"],
      "properties": {
        "reviewer": { "type": "string" },
        "decision": { "type": "string" },
        "decided_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
